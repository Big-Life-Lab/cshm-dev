# statscan.yml.example
#
# Template for Statistics Canada RDC environment.
# Copy to config/statscan.yml and fill in actual paths.
# config/statscan.yml is gitignored — never commit real RDC paths.
#
# Usage: Sys.setenv(R_CONFIG_ACTIVE = "statscan"); cfg <- load_study_config()

default:
  data_source: master
  # Master file paths; timing precision varies by cycle.
  # SMK_01C, SMK_040 instead of PUMF midpoint estimates
  raw_data_dir: "/path/to/rdc/cchs/master/rdata"
  data_type: ".RData"
  sample_proportion: 1.0

  # Illustrative non-overlapping Master deliveries through 2023.
  # Match names and coverage to the actual delivery; 2024 is not yet mapped.
  cchs_cycles:
    - cchs2001_m
    - cchs2003_m
    - cchs2005_m
    - cchs2007_2008_m
    - cchs2009_2010_m
    - cchs2011_2012_m
    - cchs2013_2014_m
    - cchs2015_2016_m
    - cchs2017_2018_m
    - cchs2019_2020_m
    - cchs2021_m
    - cchs2022_m
    - cchs2023_m

  # Output paths within RDC vetting folder
  derived_data:
    study_data: "/path/to/rdc/output/study_data.rds"
    analysis_data: "/path/to/rdc/output/analysis_data.rds"

  log_level: "WARN"
  log_file: "/path/to/rdc/logs/cshm-statscan.log"
